{
  "name": "ensushi-local",
  "productName": "EnSushi Local",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio del local: recibe los pedidos de la web, confirma horario o rechaza, e imprime la comanda.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "node build.mjs && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ar.com.ensushi.local",
    "productName": "EnSushi Local",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "EnSushi Local",
      "artifactName": "EnSushi-Local-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost:3000/app-local/"
      }
    ]
  }
}
